[Unit]
Description=Minecraft server
Wants=network-online.target
After=network-online.target mc-boot.service
Requires=mc-boot.service

[Service]
User=minecraft
WorkingDirectory=/srv/minecraft
Environment=AWS_DEFAULT_REGION=us-east-1
ExecStart=/usr/bin/java -Xms2G -Xmx3G -jar server.jar nogui
Sockets=minecraft.socket
StandardInput=socket
StandardOutput=journal
StandardError=journal
SuccessExitStatus=143
# After Minecraft stops (and has saved its world), copy it to S3.
ExecStopPost=/opt/mc/mc-backup.sh --offline
TimeoutStopSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target