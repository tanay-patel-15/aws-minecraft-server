#!/bin/bash
# Stops the server. Minecraft saves the world as it shuts down. Safe to run when already stopped.
set -euo pipefail
# shellcheck source=bin/lib.sh
source "$(dirname "$0")/lib.sh"

require_aws_cli
load_outputs

if [[ "$(instance_state)" == stopped ]]; then
  echo "The server is already stopped."
  exit 0
fi

echo "Stopping the server (Minecraft saves the world first)..."
aws ec2 stop-instances --instance-ids "$INSTANCE_ID" > /dev/null
aws ec2 wait instance-stopped --instance-ids "$INSTANCE_ID"
echo "Server stopped."